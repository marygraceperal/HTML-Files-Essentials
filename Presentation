<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Creating and Hosting HTML Learning Materials</title>
    <style>
        :root {
            --primary: #5b21b6;
            --secondary: #7c3aed;
            --accent: #ddd6fe;
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-primary: #1e293b;
            --border-muted: #e2e8f0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-primary);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 100vh;
            overflow: hidden;
        }

        header {
            background-color: var(--primary);
            color: #ffffff;
            padding: 16px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        header h1 {
            font-size: 1.25rem;
            font-weight: 700;
        }

        .slide-counter {
            background-color: var(--secondary);
            padding: 4px 12px;
            border-radius: 16px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px;
        }

        .slide {
            display: none;
            width: 100%;
            max-width: 850px;
            background-color: var(--card-bg);
            border: 1px solid var(--border-muted);
            border-top: 6px solid var(--primary);
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
            animation: fadeIn 0.3s ease-in-out;
        }

        .slide.active {
            display: block;
        }

        .task-badge {
            display: inline-block;
            background-color: var(--accent);
            color: var(--primary);
            padding: 4px 12px;
            border-radius: 4px;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .slide-title {
            color: var(--primary);
            font-size: 1.75rem;
            margin-bottom: 16px;
        }

        .slide-content {
            font-size: 1.1rem;
            color: #334155;
            line-height: 1.6;
        }

        .slide-content code {
            background-color: #f1f5f9;
            color: var(--primary);
            padding: 2px 6px;
            border-radius: 4px;
            font-family: monospace;
            font-weight: 600;
        }

        .note-box {
            margin-top: 20px;
            padding: 16px;
            background-color: #faf5ff;
            border-left: 4px solid var(--secondary);
            border-radius: 0 6px 6px 0;
            font-size: 0.95rem;
            color: #4c1d95;
        }

        footer {
            background-color: #ffffff;
            border-top: 1px solid var(--border-muted);
            padding: 16px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-btn {
            background-color: var(--primary);
            color: #ffffff;
            border: none;
            padding: 10px 24px;
            font-size: 0.95rem;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .nav-btn:hover {
            background-color: var(--secondary);
        }

        .nav-btn:disabled {
            background-color: #cbd5e1;
            cursor: not-allowed;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <header>
        <h1>Creating & Hosting HTML Learning Materials</h1>
        <div class="slide-counter" id="slide-counter">Step 1 of 17</div>
    </header>

    <main>
        <!-- TASK 1 -->
        <div class="slide active">
            <span class="task-badge">Task 1: Generating HTML File</span>
            <h2 class="slide-title">Step 1: Curriculum Guide Preparation</h2>
            <div class="slide-content">
                Prepare the Curriculum Guide (CG) for your assigned learning area.
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 1: Generating HTML File</span>
            <h2 class="slide-title">Step 2: Download Resources & Select Language</h2>
            <div class="slide-content">
                Open the provided link, click <strong>DOWNLOAD LEARNING MATERIALS</strong>, open the <em>Prompt Folder</em>, and select the appropriate language for your subject.
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 1: Generating HTML File</span>
            <h2 class="slide-title">Step 3: Customize Prompt Inputs</h2>
            <div class="slide-content">
                Edit the <em>Teacher Inputs</em> enclosed in brackets (e.g., <code>[...]</code>) using the details from your Curriculum Guide.
                <div class="note-box">
                    <strong>Reminder:</strong> Do not modify any other text in the prompt to ensure accurate results.
                </div>
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 1: Generating HTML File</span>
            <h2 class="slide-title">Step 4: Generate Code via AI</h2>
            <div class="slide-content">
                Open your preferred AI platform (Gemini, ChatGPT, Claude, etc.), paste the entire customized prompt into the chat box, and generate the HTML code.
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 1: Generating HTML File</span>
            <h2 class="slide-title">Step 5: Paste Code into Text Editor</h2>
            <div class="slide-content">
                Copy the full HTML code provided by the AI and paste it into <strong>Notepad</strong> (or your preferred text editor).
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 1: Generating HTML File</span>
            <h2 class="slide-title">Step 6: Save as HTML File</h2>
            <div class="slide-content">
                In Notepad, click <strong>File > Save As</strong>, locate your designated <em>codes</em> folder, and save the file with an <code>.html</code> extension (e.g., <code>topic.html</code>).
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 1: Generating HTML File</span>
            <h2 class="slide-title">Step 7: Inspect and Revise</h2>
            <div class="slide-content">
                Open the saved <code>.html</code> file in a web browser to inspect it. If changes are needed, prompt the AI to revise the code and repeat Steps 5 to 7.
            </div>
        </div>

        <!-- TASK 2 -->
        <div class="slide">
            <span class="task-badge">Task 2: Pre-Upload Verification</span>
            <h2 class="slide-title">Step 8: Verify Document Title</h2>
            <div class="slide-content">
                Check the <code>&lt;title&gt;</code> element in the HTML code to ensure the correct subject name appears on the browser tab.
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 2: Pre-Upload Verification</span>
            <h2 class="slide-title">Step 9: Test Navigation & Layout</h2>
            <div class="slide-content">
                Click through all 6 section tabs to confirm smooth navigation, and resize your browser window to verify responsive layout styling.
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 2: Pre-Upload Verification</span>
            <h2 class="slide-title">Step 10: Test Print View</h2>
            <div class="slide-content">
                Click the <strong>Print</strong> button (or press <code>Ctrl + P</code>) to ensure the print stylesheet outputs clean content without showing navigation buttons or tab bars.
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 2: Pre-Upload Verification</span>
            <h2 class="slide-title">Step 11: Review Content Completeness</h2>
            <div class="slide-content">
                Review the content thoroughly to ensure no missing text, leftover code artifacts, or unfulfilled placeholders (e.g., <code>[INSERT TITLE]</code>) remain.
            </div>
        </div>

        <!-- TASK 3 -->
        <div class="slide">
            <span class="task-badge">Task 3: GitHub Deployment</span>
            <h2 class="slide-title">Step 12: Create a GitHub Account</h2>
            <div class="slide-content">
                Navigate to <a href="https://github.com" target="_blank" style="color: var(--secondary);">GitHub</a> and sign up for a free account.
                <div class="note-box">
                    <strong>Reminder:</strong> Choose a professional username, as it will serve as the ownership mark in your public website URL.
                </div>
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 3: GitHub Deployment</span>
            <h2 class="slide-title">Step 13: Create a New Repository</h2>
            <div class="slide-content">
                From your GitHub Dashboard, click <strong>New</strong> or the <strong>+</strong> icon to create a new repository.
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 3: GitHub Deployment</span>
            <h2 class="slide-title">Step 14: Configure Repository Settings</h2>
            <div class="slide-content">
                Name your repository (e.g., <code>learning-materials</code>), set the visibility to <strong>Public</strong>, and click <strong>Create repository</strong>.
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 3: GitHub Deployment</span>
            <h2 class="slide-title">Step 15: Upload Your HTML File</h2>
            <div class="slide-content">
                Click <strong>uploading an existing file</strong>, drag and drop your verified <code>.html</code> file, and click <strong>Commit changes</strong>.
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 3: GitHub Deployment</span>
            <h2 class="slide-title">Step 16: Enable GitHub Pages</h2>
            <div class="slide-content">
                Go to repository <strong>Settings > Pages</strong> (in the left sidebar). Under <em>Build and deployment</em>, select the <strong>main</strong> branch and click <strong>Save</strong>.
            </div>
        </div>

        <div class="slide">
            <span class="task-badge">Task 3: GitHub Deployment</span>
            <h2 class="slide-title">Step 17: Access Your Live Website</h2>
            <div class="slide-content">
                Wait 1–2 minutes, refresh the page, and retrieve your published website link formatted as:
                <br><br>
                <code>https://[username].github.io/[repository-name]/[topic].html</code>
            </div>
        </div>
    </main>

    <footer>
        <button class="nav-btn" id="prev-btn" onclick="changeSlide(-1)" disabled>Previous</button>
        <button class="nav-btn" id="next-btn" onclick="changeSlide(1)">Next</button>
    </footer>

    <script>
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');
        const counter = document.getElementById('slide-counter');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');

        function updateSlide() {
            slides.forEach((slide, index) => {
                slide.classList.toggle('active', index === currentSlide);
            });

            counter.textContent = `Step ${currentSlide + 1} of ${slides.length}`;
            prevBtn.disabled = currentSlide === 0;
            nextBtn.disabled = currentSlide === slides.length - 1;
        }

        function changeSlide(direction) {
            currentSlide += direction;
            if (currentSlide < 0) currentSlide = 0;
            if (currentSlide >= slides.length) currentSlide = slides.length - 1;
            updateSlide();
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === ' ') {
                if (currentSlide < slides.length - 1) changeSlide(1);
            } else if (e.key === 'ArrowLeft') {
                if (currentSlide > 0) changeSlide(-1);
            }
        });
    </script>
</body>
</html>
